# Scholarly evidence
KAGUA_CONTACT_EMAIL=research@example.org
OPENALEX_API_KEY=
KAGUA_EVIDENCE_ADAPTER_URL=
KAGUA_EVIDENCE_ADAPTER_TOKEN=

# LLM mode: godmode | provider | local | none
KAGUA_LLM_MODE=godmode

# DeepSeek-first Godmode provider (official hosted API is usage-priced)
KAGUA_DEEPSEEK_API_KEY=
KAGUA_DEEPSEEK_MODEL=deepseek-v4-flash

# Optional fallbacks. Model IDs are explicit environment settings so deployments
# are not locked to stale defaults when vendors rename models.
KAGUA_OPENAI_API_KEY=
KAGUA_OPENAI_MODEL=
KAGUA_OPENROUTER_API_KEY=
KAGUA_OPENROUTER_MODEL=

# Generic OpenAI-compatible fallback
KAGUA_CLOUD_API_KEY=
KAGUA_CLOUD_BASE_URL=
KAGUA_CLOUD_MODEL=
