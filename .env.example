# Required in production. Crossref asks production clients to identify themselves.
KAGUA_CONTACT_EMAIL=research@example.org

# Optional. If your OpenAlex plan/API configuration uses a key, set it here.
OPENALEX_API_KEY=

# Server-side cloud LLM defaults. Users may also supply BYOK values per request.
KAGUA_LLM_MODE=none
KAGUA_CLOUD_BASE_URL=https://api.openai.com/v1
KAGUA_CLOUD_MODEL=
KAGUA_CLOUD_API_KEY=

# For self-hosted deployments only. Browser-local mode uses the endpoint entered in the UI.
KAGUA_LOCAL_BASE_URL=http://127.0.0.1:11434
KAGUA_LOCAL_MODEL=

# Optional institutional/licensed evidence adapter. This is how production Kagua
# can ingest authorised JCR/Scopus/publisher facts without embedding licensed data.
KAGUA_EVIDENCE_ADAPTER_URL=
KAGUA_EVIDENCE_ADAPTER_TOKEN=

# Authorised journal evidence adapter may return per ISSN:
# { quartile, impactFactor, impactFactorYear, impactFactorPercentile, apcUsd, firstDecisionDays, source, sourceUrl, observedAt, confidence }
# Raw JIF/JIF percentile should only be supplied from an authorised Clarivate/JCR integration.
