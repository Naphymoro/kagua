# Authentication - Kagua is restricted server-side to verified @aimsric.org Google accounts
# Generate with: npx auth secret
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Legacy aliases also supported:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Scholarly evidence
KAGUA_CONTACT_EMAIL=research@example.org
OPENALEX_API_KEY=
KAGUA_EVIDENCE_ADAPTER_URL=
KAGUA_EVIDENCE_ADAPTER_TOKEN=

# Manuscript upload OCR
# Run Baidu Unlimited-OCR behind a small HTTP adapter, Hugging Face endpoint, or another OCR service.
OCR_PROVIDER=unlimited-ocr
OCR_ENDPOINT_URL=
OCR_API_KEY=
OCR_MAX_UPLOAD_MB=25
OCR_TIMEOUT_MS=55000

# LLM mode: godmode | provider | local | none
KAGUA_LLM_MODE=godmode
KAGUA_DEEPSEEK_API_KEY=
KAGUA_DEEPSEEK_MODEL=deepseek-v4-flash
KAGUA_OPENAI_API_KEY=
KAGUA_OPENAI_MODEL=
KAGUA_OPENROUTER_API_KEY=
KAGUA_OPENROUTER_MODEL=
KAGUA_CLOUD_API_KEY=
KAGUA_CLOUD_BASE_URL=
KAGUA_CLOUD_MODEL=
